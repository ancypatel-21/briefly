# Copy this file to .env and fill in the values, then:
#   docker compose up -d && npm run db:migrate && npm run db:seed && npm run dev

# Postgres connection string. The default matches docker-compose.yml — just
# run `docker compose up -d` and leave this as-is for local dev.
DATABASE_URL="postgresql://briefly:briefly@localhost:5433/briefly?schema=public"

# Secret used to sign session JWTs. Generate your own with: openssl rand -base64 32
# Any long random string works for local dev; use a real generated secret in production.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Not used yet ---
#
# Briefly's meeting understanding features (AI-generated summaries, action-item
# extraction, natural-language search, and contextual Q&A over past meetings)
# are not wired up yet — see src/lib/processing.ts. When that work starts, it
# will call the Claude API (via @anthropic-ai/sdk) and read its key from here.
#
# Get a key at https://console.anthropic.com/ and uncomment the line below.
# Recommended model once this is implemented: claude-opus-5
# ANTHROPIC_API_KEY="sk-ant-..."
